{
  "name": "@cluesurf/wave",
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "make": "rm -rf host && mkdir -p host && pnpm exec tsc --project tsconfig.json --pretty --noEmitOnError false && pnpm exec tsc-alias --project tsconfig.json && cp package.json host",
    "scan": "rm -rf host && concurrently --kill-others \"tsc -w\" \"tsc-alias -w\"",
    "lint": "eslint --ext .ts ./make --fix",
    "test:make": "npx tsx test/make.ts",
    "test": "npx tsx --no-warnings=ExperimentalWarning test/index.ts",
    "host": "pnpm make && npm publish --access=public",
    "work": "remix vite:dev"
  },
  "prettier": "@cluesurf/wash/flow.json",
  "dependencies": {
    "@remix-run/express": "2.17.4",
    "@remix-run/node": "2.17.4",
    "@remix-run/react": "2.17.4",
    "@remix-run/serve": "2.17.4",
    "@types/express": "5.0.6",
    "isbot": "5.1.35",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tailwindcss": "4.1.18",
    "tone": "^15.1.22"
  },
  "devDependencies": {
    "@cluesurf/wash": "0.7.0",
    "@remix-run/dev": "2.17.4",
    "@tailwindcss/vite": "4.1.18",
    "@types/lodash": "4.17.23",
    "@types/node": "25.2.3",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "concurrently": "9.2.1",
    "eslint": "10.0.0",
    "express": "5.2.1",
    "ts-morph": "27.0.2",
    "ts-node": "^10.9.2",
    "tsc-alias": "1.8.16",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "vite": "7.3.1"
  }
}
