{
  "name": "@cluesurf/wave",
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "make": "rm -rf host && mkdir -p host && pnpm exec tsc --project tsconfig.json --pretty --noEmitOnError false && pnpm exec tsc-alias --project tsconfig.json && cp package.json host",
    "scan": "rm -rf host && concurrently --kill-others \"tsc -w\" \"tsc-alias -w\"",
    "lint": "eslint --ext .ts ./make --fix",
    "test:make": "npx tsx test/make.ts",
    "test": "npx tsx --no-warnings=ExperimentalWarning test/index.ts",
    "host": "pnpm make && npm publish --access=public",
    "work": "remix vite:dev"
  },
  "prettier": "@cluesurf/wash/flow.json",
  "dependencies": {
    "@remix-run/express": "^2.17.2",
    "@remix-run/node": "^2.5.0",
    "@remix-run/react": "^2.5.0",
    "@remix-run/serve": "^2.5.0",
    "@types/express": "^5.0.5",
    "isbot": "^4.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.1.17",
    "tone": "^15.1.22"
  },
  "devDependencies": {
    "@cluesurf/wash": "^0.6.0",
    "@remix-run/dev": "^2.5.0",
    "@tailwindcss/vite": "^4.0.0",
    "@types/lodash": "^4.14.194",
    "@types/node": "^22.15.3",
    "@types/react": "^19.0.1",
    "@types/react-dom": "^19.0.2",
    "concurrently": "^7.6.0",
    "eslint": "^9.26.0",
    "express": "^5.1.0",
    "ts-morph": "^26.0.0",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.8.15",
    "tsx": "^3.12.7",
    "typescript": "^5.8.3",
    "vite": "^7.2.4"
  }
}
